{ "name": "Staqlt CRM Orchestrator", "flow": [ { "id": 1, "module": "gateway:CustomWebhook", "parameters": { "webhookId": "LEAD_INGEST_01" }, "next": [2] }, { "id": 2, "module": "json:ParseJSON", "parameters": { "json": "{{1.data}}" }, "next": [3] }, { "id": 3, "module": "router:Router", "routes": [ { "filter": "{{2.email}} IS NOT EMPTY", "next": [4] }, { "filter": "fallback", "next": [99] } ] }, { "id": 4, "module": "salesforce:UpsertRecord", "parameters": { "object": "Lead", "externalId": "Email", "values": { "FirstName": "{{2.firstName}}", "LastName": "{{2.lastName}}", "Company": "{{2.company}}" } }, "error_handler": { "module": "core:Break", "parameters": { "max_retries": 3, "interval": 5 } } }, { "id": 99, "module": "slack:PostMessage", "parameters": { "channel": "C_ALERTS", "text": "Failed lead ingestion: {{2.raw_payload}}" } } ] }